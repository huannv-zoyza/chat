# Chép thành .env rồi điền. File .env đã nằm trong .gitignore — đừng commit.
#   cp .env.example .env
# Biến đã export sẵn ngoài shell sẽ thắng file này.
# Đổi đường dẫn file bằng ENV_FILE=/duong/dan/khac ./go-chat

# ─── Muse (Ask AI qua tài khoản Muse của bạn) ──────────────────────────────
# Bỏ trống MUSE_COOKIE là tắt hẳn Muse, phần còn lại của app không đổi gì.
#
# Lấy cookie: mở muse.ai đã đăng nhập → DevTools → Network → lọc "api/session"
#   → chuột phải request → Copy → Copy as cURL → lấy giá trị sau -b '...'
# ĐÂY LÀ TOKEN ĐĂNG NHẬP: ai có là vào được tài khoản bạn.
MUSE_COOKIE=

# Lấy bằng DevTools → Console → gõ: navigator.userAgent
# Nên khớp đúng trình duyệt đã copy cookie, lệch nhiều dễ bị huỷ phiên.
MUSE_UA=

# Proxy đi ra (tuỳ chọn), ví dụ http://127.0.0.1:8888
MUSE_PROXY=

# Hiếm khi cần đổi
# MUSE_ORIGIN=https://muse.ai
# MUSE_GATEWAY=wss://hatch.metaaivm.com/v1/noise

# ─── Các nhà cung cấp AI khác (xem ai/config.go) ───────────────────────────
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# POLLINATIONS_API_KEY=
# TOGETHER_API_KEY=

# ─── Khác ──────────────────────────────────────────────────────────────────
# GIPHY_API_KEY=
# ICE_SERVERS=
